{
  "name": "maa-pipeline-editor-repository",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "ed:install": "yarn --cwd Editor install --frozen-lockfile",
    "dev": "yarn --cwd Editor dev",
    "ed:build": "yarn --cwd Editor build",
    "server": "yarn --cwd LocalBridge dev",
    "lb:deps": "node scripts/development/update-lb-deps.mjs",
    "lb:update": "node scripts/development/update-mfw.mjs",
    "desk:install": "yarn --cwd Desktop install --frozen-lockfile",
    "desk:prepare": "node scripts/development/prepare-desktop.mjs",
    "desk": "yarn desk:prepare && yarn --cwd Desktop tauri dev",
    "desk:build": "yarn --cwd Desktop tauri build",
    "revision": "node scripts/development/bump-desktop-revision.mjs",
    "doc": "yarn --cwd DocumentStation dev",
    "refs:sync": "node scripts/docs/run-sync-reference-projects.mjs",
    "web:dev": "yarn --cwd Landing dev",
    "web:build": "yarn --cwd Landing build",
    "migrate": "node scripts/development/migrate-version.mjs",
    "proto": "node scripts/development/proto-version.mjs",
    "release": "git tag -a v2.0.6 -m \"v2.0.6\" && git push origin v2.0.6",
    "retag": "git tag -d v2.0.6",
    "reset": "git reset --soft HEAD~1"
  }
}
