{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPE Desktop",
  "version": "2.0.2",
  "identifier": "site.codax.mpe.desktop",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "MPE Desktop - Launcher",
        "center": true,
        "visible": false,
        "backgroundColor": "#17263e",
        "width": 1280,
        "height": 790,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://mpe.localhost mpe:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
